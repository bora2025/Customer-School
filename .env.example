WATTANAM_DISTRIBUTION=core
APP_VERSION=0.1.0
APP_URL=https://school.example.com
COOKIE_SECURE=true
POSTGRES_IMAGE=postgres:18
POSTGRES_DB=wattanam
POSTGRES_USER=wattanam
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-48-random-bytes
API_IMAGE=replace-with-a-digest-pinned-api-image
WEB_IMAGE=replace-with-a-digest-pinned-web-image
GATEWAY_IMAGE=replace-with-a-digest-pinned-gateway-image
PLUGIN_TRUSTED_KEYS={}
UPDATE_REPOSITORY_KEY_ID=
UPDATE_REPOSITORY_PUBLIC_KEY=
# Optional. Leave empty for a standalone school.
MARKETPLACE_URL=
