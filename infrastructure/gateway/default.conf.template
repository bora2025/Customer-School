map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Service containers receive new private addresses after rolling deployments. Resolve through the
# environment's DNS continuously instead of pinning the address that existed when Nginx started.
resolver ${DNS_RESOLVER} valid=10s ipv6=on;

upstream api_backend {
    zone api_backend 64k;
    server ${API_UPSTREAM} resolve;
}

upstream web_backend {
    zone web_backend 64k;
    server ${WEB_UPSTREAM} resolve;
}

server {
    listen 8080;
    server_name _;

    gzip on;
    gzip_types application/javascript application/json application/xml text/css text/plain;

    # Browser security headers for every response. Keep add_header out of location blocks:
    # any add_header there silently drops all of these for that location.
    # Camera and geolocation stay allowed for this origin (attendance scanners, transport).
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()" always;
    # Content-Security-Policy, phase 1: REPORT-ONLY (blocks nothing). This is the strict target
    # policy; browsers report what it would block to /api/csp-report (logged by the API as
    # "CSP report violation"). report-uri only: Chromium sends nothing when report-to is also set.
    # Next.js inline scripts are expected to report until phase 2 adds
    # per-request nonces; any other reported origin must be reviewed before enforcing.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'self'; manifest-src 'self'; report-uri /api/csp-report" always;
    # Drop upstream copies (helmet on the API sets some) so each header is sent exactly once;
    # a duplicated X-Frame-Options can make browsers ignore it.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header X-Powered-By;
    server_tokens off;

    location = /gateway-health {
        default_type text/plain;
        return 200 "ok";
    }

    location ^~ /socket.io/ {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/marketplace/ {
        proxy_pass http://web_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://api_backend/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://web_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
