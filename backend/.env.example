# Runtime
NODE_ENV=development
PORT=3001
APP_VERSION=0.0.1-dev
# Set this to the immutable build commit in production.
GIT_COMMIT=
# Feature set: legacy-full (every built-in module, the default) or core (the lean core alone).
# Any other value stops startup.
WATTANAM_DISTRIBUTION=legacy-full

# Database
DATABASE_URL=postgresql://wattanam:change-me@localhost:5432/wattanam?schema=public
# Optional privileged connection used only for API startup migrations.
# Runtime API and worker processes continue using DATABASE_URL.
MIGRATION_DATABASE_URL=

# Authentication
# Production requires a unique value containing at least 32 characters.
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7
COOKIE_SECURE=false

# CORS
# Comma-separated exact origins. This value is mandatory in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3004
PUBLIC_APP_URL=http://localhost:3000

# Optional email delivery
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@example.com

# Optional SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Operational backups
BACKUP_DIR=./backups
# Set to 0 to retain all files. Production should use an approved retention policy.
BACKUP_RETENTION_DAYS=30
RECOVERY_DRILL_DATABASE_URL=
RECOVERY_DRILL_CONFIRM_TARGET=EMPTY

# Signed plugin runtime
PLUGIN_DIR=./plugins-installed
PLUGIN_DATA_DIR=./plugin-data
PLUGIN_STORAGE_MAX_FILE_BYTES=1048576
PLUGIN_STORAGE_MAX_TOTAL_BYTES=104857600
# Per-plugin runtime limits. Request/SQL/realtime values are per process per minute;
# job is concurrent per process and notifications are durable per UTC day.
PLUGIN_REQUEST_QUOTA_PER_MINUTE=600
PLUGIN_SQL_QUOTA_PER_MINUTE=300
PLUGIN_REALTIME_QUOTA_PER_MINUTE=600
PLUGIN_JOB_QUOTA_PER_PLUGIN=2
PLUGIN_NOTIFICATION_DAILY_LIMIT=200
PLUGIN_JOB_DRAIN_TIMEOUT_MS=30000
PLUGIN_EVENT_MAX_BYTES=65536
PLUGIN_READ_MODEL_MAX_BYTES=262144
# Plugin-owned object storage: local (default), s3, dual-local-primary, or dual-s3-primary.
PLUGIN_STORAGE_PROVIDER=local
# Transaction-local PostgreSQL limits for plugin runtime SQL and install migrations.
PLUGIN_SQL_STATEMENT_TIMEOUT_MS=5000
PLUGIN_SQL_LOCK_TIMEOUT_MS=1000
PLUGIN_MIGRATION_STATEMENT_TIMEOUT_MS=30000
PLUGIN_MIGRATION_LOCK_TIMEOUT_MS=5000
# Emergency package-signing deny-list. Supports ["publisher:key-id"] or {"publisher":["key-id"]}.
PLUGIN_REVOKED_PUBLISHER_KEYS_JSON=[]
PLUGIN_STORAGE_S3_ENDPOINT=
PLUGIN_STORAGE_S3_BUCKET=
PLUGIN_STORAGE_S3_REGION=auto
PLUGIN_STORAGE_S3_ACCESS_KEY_ID=
PLUGIN_STORAGE_S3_SECRET_ACCESS_KEY=
PLUGIN_STORAGE_S3_FORCE_PATH_STYLE=true
PLUGIN_STORAGE_S3_PREFIX=plugin-data
# Emergency mode: keep core/admin running without loading or activating plugins.
PLUGIN_SAFE_MODE=false
PLUGIN_MAX_PACKAGE_BYTES=52428800
PLUGIN_MAX_UNPACKED_BYTES=52428800
# Prefer a mounted file in production. Structure: publisher -> key id -> PEM public key.
PLUGIN_TRUSTED_KEYS_FILE=
PLUGIN_TRUSTED_KEYS={}
PLUGIN_IN_PROCESS_PUBLISHERS=wattanam

# Optional official update repository. Leave MARKETPLACE_URL empty to disable checks.
MARKETPLACE_URL=
UPDATE_CHANNEL=stable
UPDATE_REPOSITORY_KEY_ID=official-repository-2026
UPDATE_REPOSITORY_PUBLIC_KEY_FILE=
# Railway alternative; supports a PEM with literal \\n separators.
UPDATE_REPOSITORY_PUBLIC_KEY=
# Optional JSON key-id -> PEM map during an overlap rotation; remove retired keys after the support window.
UPDATE_REPOSITORY_PUBLIC_KEYS_JSON=
UPDATE_MAX_ARTIFACT_BYTES=52428800
UPDATE_INDEX_TIMEOUT_MS=10000
UPDATE_ARTIFACT_TIMEOUT_MS=30000
