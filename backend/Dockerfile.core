FROM node:20-slim AS builder

RUN apt-get update -qq && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts

# The Nest webpack checker resolves source types through @prisma/client. Generate the legacy
# superset client only inside this disposable builder for compile-time types, then separately
# generate and bundle the reduced runtime client from the core schema. Neither legacy schema nor
# legacy client is copied into the runner image.
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma/core ./prisma/core
RUN ./node_modules/.bin/prisma generate --schema=prisma/schema.prisma \
    && ./node_modules/.bin/prisma generate --schema=prisma/core/schema.prisma

COPY src ./src
COPY nest-cli.json tsconfig.json tsconfig.core.json webpack.core.config.js ./
RUN npm run build:core

FROM node:20-slim AS production-dependencies

RUN apt-get update -qq && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --legacy-peer-deps --ignore-scripts

# Prisma is a deliberate runtime dependency because the container deploys the reduced core
# migrations before starting. Generate only the reduced client in this production dependency tree.
COPY prisma/core ./prisma/core
RUN ./node_modules/.bin/prisma generate --schema=prisma/core/schema.prisma \
    && mkdir -p node_modules/.prisma \
    && cp -R generated/core-client node_modules/.prisma/client

FROM node:20-slim AS runner

ARG POSTGRES_CLIENT_MAJORS="16 18"
RUN apt-get update -qq \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg gosu openssl tar \
    && install -d -m 0755 /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
       | gpg --dearmor -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo ${VERSION_CODENAME})-pgdg main" \
       > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends $(for major in ${POSTGRES_CLIENT_MAJORS}; do printf 'postgresql-client-%s ' "$major"; done) \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

WORKDIR /app

COPY --chown=node:node --from=builder /app/package.json ./
COPY --chown=node:node --from=production-dependencies /app/node_modules ./node_modules
COPY --chown=node:node --from=production-dependencies /app/generated ./generated
COPY --chown=node:node --from=builder /app/dist-core ./dist-core
COPY --chown=node:node --from=builder /app/prisma/core ./prisma/core
COPY --chown=node:node scripts/db-toolkit.js scripts/plugin-recovery-contract.js scripts/backup-database.js scripts/backup-recovery-set.js scripts/restore-database.js scripts/restore-recovery-set.js scripts/deploy-migrations.js scripts/verify-fresh-core-database.js ./scripts/

RUN mkdir -p /data/backups /data/plugins /data/plugin-data /data/update-state /data/marketplace-identity \
    && chown -R node:node /data /app

ENV NODE_ENV=production
ENV PROCESS_ROLE=combined
ENV WATTANAM_DISTRIBUTION=core

EXPOSE 3001

CMD ["sh", "-c", "mkdir -p /data/backups /data/plugins /data/plugin-data /data/update-state /data/marketplace-identity && chown -R node:node /data && gosu node node scripts/deploy-migrations.js && exec gosu node node dist-core/main.js"]
